# Numbers — MT5 Discipline & Ledger Agent
# Central config. Copy to .env and fill in.

# ---- MT5 rpyc bridge (mt5linux, runs on the Linux box next to MT5) ----
MT5_HOST=localhost
MT5_PORT=8001
# Comma-separated instruments you scalp
SYMBOLS=XAUUSD,BTCUSD

# ---- Mission / capital ----
# TOTAL capital including money in the wallet (NOT just the MT5 balance).
START_CAPITAL=1000
TARGET_CAPITAL=40000
WORKING_DAYS=13
# Date the challenge starts (YYYY-MM-DD). Working days skip Sat/Sun.
START_DATE=2026-07-08

# ---- Exposure policy (of TOTAL capital, not wallet) ----
# The MT5 account should normally hold this % of total capital...
EXPOSURE_MIN_PCT=5.0
# ...and never more than this %.
EXPOSURE_MAX_PCT=7.5

# ---- Pushover notifications ----
PUSHOVER_TOKEN=
PUSHOVER_USER=
